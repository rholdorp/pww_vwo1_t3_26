rules_version = '2';

// Lichtere bescherming (per Ralph's keuze 2026-06-07):
//   - Read open: iedereen met de URL kan voortgang van een naam-slug lezen.
//   - Write self-attested: een client kan alleen schrijven naar /progress/{slug}
//     als request.resource.data.naam == slug. Voorkomt typo's en cross-naam
//     overschrijven; houdt geen kwaadwillende tegen (geen auth, repo publiek).
//
// Doc-vorm:
//   /progress/{slug}  =>  { naam: slug, items: { ...itemId: ItemProgress },
//                            schrijf: { ...opdrachtId: SchrijfState },
//                            updated: <serverTimestamp> }
//
// `naam-slug` regex: lowercase a-z, 0-9, en koppelstreepjes (zie progress.ts).

service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{naam} {
      allow read: if true;
      allow create, update: if
        request.resource.data.naam is string
        && request.resource.data.naam == naam
        && naam.matches('^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$');
      // Geen delete via client.
      allow delete: if false;
    }
  }
}
