# Kopieer naar apps/web/.env (gitignored) voor lokaal draaien.
# Zie DEPLOY.md voor productie-deploy (GitHub Pages + Firebase).

# ── 1. Nederlands schrijf-trainer (Cat 4) — LLM-feedback ─────────────────────
# Lokaal: ANTHROPIC_API_KEY blijft server-side (Vite dev-middleware) en komt
# NIET in de client-bundle. Zonder key valt de trainer terug op de zelf-nakijk-
# checklist. In productie loopt dit via een Cloud Function (zie hieronder).
ANTHROPIC_API_KEY=sk-ant-...

# ── 2. Firebase web-config (publiek, mag in de bundle) ───────────────────────
# Haal deze waarden op uit de Firebase Console na "Add web app". Zonder deze
# waarden draait de app op localStorage-only (geen cross-device sync).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Regio waar de Cloud Functions draaien (default: europe-west1).
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# ── 3. Cloud Function endpoint (productie) ───────────────────────────────────
# Basis-URL waar onze Cloud Functions onder bereikbaar zijn, bv.
#   https://europe-west1-<projectId>.cloudfunctions.net
# Leeg laten in dev → de app gebruikt automatisch de Vite-middleware op
# /api/schrijf-feedback in plaats van de Cloud Function.
VITE_FUNCTIONS_BASE_URL=
